    <string name="s_about">Tentang</string>
    <string name="about_text">Launcher gratis untuk Android TV.\n\nRemote: OK membuka aplikasi; tahan OK atau Menu pada ikon — favorit, urutan, sembunyikan.\n\nVideo udara di-stream dari server publik Apple. Osmon tidak berafiliasi dengan Apple.</string>
