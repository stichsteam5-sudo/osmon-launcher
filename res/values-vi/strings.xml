    <string name="s_howto">Cách thêm chủ đề của riêng bạn</string>
    <string name="howto_title">Chủ đề của bạn</string>
    <string name="howto_text">Chủ đề là một thư mục trong Osmon/themes trên bộ nhớ TV.\n\n• Thư mục có một ảnh hoặc video = chủ đề với hình nền đó.\n• Thư mục có nhiều ảnh = chủ đề trình chiếu.\n• Tệp theme.json trong thư mục đặt tên, màu và độ tối.\n\nTừ máy tính:\nadb push FOLDER /sdcard/Osmon/themes/\n\nĐặt hình nền riêng lẻ vào /sdcard/Osmon/wallpapers rồi chọn trong “Hình nền”.\n\nDùng video 1080p — 4K sẽ làm menu chậm.</string>
    <string name="s_android">Cài đặt Android</string>
    <string name="err_settings">Không mở được</string>
    <string name="s_about">Giới thiệu</string>
    <string name="about_text">Trình khởi chạy miễn phí cho Android TV.\n\nĐiều khiển: OK để mở ứng dụng; giữ OK hoặc Menu trên biểu tượng — yêu thích, thứ tự, ẩn.\n\nVideo trên không được phát từ máy chủ công khai của Apple. Osmon không liên kết với Apple.</string>
